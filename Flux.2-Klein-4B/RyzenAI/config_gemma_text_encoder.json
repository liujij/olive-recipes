{
    "input_model": {
        "type": "PyTorchModel",
        "model_path": "google/gemma-4-E2B",
        "model_loader": "gemma_with_adapter_load",
        "model_script": "user_script.py",
        "io_config": {
            "input_names": ["input_ids", "attention_mask"],
            "output_names": ["prompt_embeds"],
            "dynamic_axes": {
                "input_ids":     {"0": "batch", "1": "seq_len"},
                "attention_mask":{"0": "batch", "1": "seq_len"},
                "prompt_embeds": {"0": "batch", "1": "seq_len"}
            }
        },
        "dummy_inputs_func": "gemma_with_adapter_conversion_inputs"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [{"device": "gpu", "execution_providers": ["DmlExecutionProvider"]}]
        }
    },
    "passes": {
        "convert": {
            "type": "OnnxConversion",
            "target_opset": 17,
            "save_as_external_data": true,
            "all_tensors_to_one_file": true,
            "external_data_name": "model.onnx.data"
        },
        "int4": {
            "type": "OnnxBlockWiseRtnQuantization",
            "block_size": 128,
            "is_symmetric": true,
            "accuracy_level": 4,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        }
    },
    "log_severity_level": 0,
    "evaluate_input_model": false,
    "host": "local_system",
    "target": "local_system",
    "cache_dir": "ryzenai_cache",
    "output_dir": "footprints/gemma_text_encoder"
}
