{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3-4B",
        "task": "text-generation",
        "load_kwargs": {
            "trust_remote_code": true
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "DmlExecutionProvider"
                    ]
                }
            ]
        }
    },
    "host": "local_system",
    "target": "local_system",
    "data_configs": [],
    "passes": {
        "mb": {
            "type": "ModelBuilder",
            "precision": "fp16",
            "exclude_lm_head": true,
            "extra_options": {
                "filename": "model.onnx"
            }
        },
        "model_generation": {
            "type": "VitisGenerateModelSD",
            "model_type": "qwen3-4b-text-encoder"
        }
    },
    "log_severity_level": 1,
    "cache_dir": "ryzenai_cache",
    "output_dir": "footprints/text_encoder"
}